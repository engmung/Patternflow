# OS
.DS_Store
Thumbs.db

# Editors / IDE
.vscode/
.idea/
*.swp

# Node.js (web/)
node_modules/
.next/
.vercel/
.env*.local
dist/
build/
out/
# Keep the /build app route (source, not a build artifact)
!web/src/app/build/

# Arduino build artifacts
*.hex
*.elf
*.bin
# ...except the stock images the browser flasher serves: those are release
# artifacts the site needs at runtime, and they were force-added until now.
# Build them from a checkout WITHOUT patternflow_secrets.h — that file's
# Wi-Fi credentials would otherwise be baked into a publicly downloaded image.
!web/public/flash/bin/**/*.bin
# Local staging for a release upload (bins duplicated from the flasher folder).
firmware/release/
firmware/patternflow/patternflow_secrets.h
firmware/patternflow_stream/patternflow_stream.ino/stream_secrets.h

# KiCad 자동 생성/백업
*.kicad_prl
*-backups/
.history/
fp-info-cache
_autosave-*
*.lck
~*.lck
*.kicad_pcb-bak
*.kicad_sch-bak
*.bak

# Blender backups
*.blend1
*.blend2

# Large binaries
*.zip
!hardware/pcb/gerber/**/*.zip
# Pattern packs that ship with Patternflow. Built from firmware presets by
# firmware/toolchain/make_pack.py and committed on purpose: a board with an
# empty Patterns page has to have somewhere to get patterns from, and that
# cannot depend on a database or a build queue. Rebuilds are byte-identical,
# so an unchanged pattern set produces no diff.
!web/public/packs/*.zip
*.rar
*.7z

# Antigravity / agent harness — local only
.agents/local/
.agents/cache/
*.local.md

# Claude Code local config (launch.json, settings.local.json)
.claude/

# Personal scratchpads (use external tool like Notion)
NOTES.md
TODO-personal.md

# Temporary / scratch folders
_temp/
_tmp/
temp/
tmp/
.temp/
.tmp/

# Ableton Live
**/Backup/
**/Ableton Project Info/

# Ableton bridge — the .amxd is built locally from the .maxpat (see
# integrations/ableton/README.md); Live sets stay local too
integrations/ableton/max/*.amxd
integrations/ableton/projects/


# firmware build worker scratch (warm cache + sketch copy)
/.build-worker

# Loadable pattern modules — build outputs, not sources.
# Rebuild with: python firmware/toolchain/build_module.py --all
firmware/modules/.build/
firmware/patternflow/data/patterns/

# Python bytecode from the firmware toolchain scripts
__pycache__/

# PlatformIO (firmware/patternflow) — generated/cloned, never committed
.pio/
firmware/patternflow/pio_src/
firmware/patternflow/lib/
