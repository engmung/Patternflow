# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Community (self-hosted deployment only) ──────────────────────────────────
# The community runs where this flag is set (the Raspberry Pi / VPS). Leave it
# unset on Vercel — community pages then show a pointer to the community host.
COMMUNITY_ENABLED=1

# Better Auth session signing secret. Generate one:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Public URL of THIS deployment (used by Better Auth for cookies/origin).
# Dev: http://localhost:3000 · Pi: https://community.patternflow.work
BETTER_AUTH_URL=http://localhost:3000

# Where the SQLite file lives. Default: ./data/community.db (gitignored).
# On the Pi point it somewhere backed up, e.g. /home/pi/patternflow/community.db
#COMMUNITY_DB_PATH=./data/community.db

# Public URL of the community deployment. Set this wherever the community
# should be reachable — it is also the switch that shows Pattern Lab's
# "Share to Community" button, so leave it UNSET on a deployment that ships
# before the community host exists. Set it on EVERY deployment that has one:
#  · Vercel — sends /community visitors here, and points Pattern Lab's
#    "Share to Community" / sign-in calls at this host.
#  · The community host itself — it matches its own origin, so calls stay
#    relative and no CORS is involved.
#  · Local development — http://localhost:3000 (matches, so stays relative).
NEXT_PUBLIC_COMMUNITY_URL=https://community.patternflow.work

# Origins allowed to call this community API from the browser, comma separated.
# Community deployment only. This is both the CORS allow-list and Better Auth's
# trustedOrigins (its Origin-header CSRF check), so the main site must be named
# here or cross-origin sign-in and publishing are rejected.
COMMUNITY_ALLOWED_ORIGINS=https://patternflow.work

# ── Firmware build service (community host with a worker) ────────────────────
# Server side: enables POST /api/community/builds. Needs arduino-cli installed
# and `npm run worker` running. Compiling submitted C++ is arbitrary code
# execution at compile time — keep this off until the worker is sandboxed.
#BUILD_ENABLED=1
# Client side: shows the "Build firmware" buttons. Set both, or neither.
#NEXT_PUBLIC_BUILD_ENABLED=1
# Overrides for the worker (defaults are usually right in a repo checkout):
#FIRMWARE_SRC_DIR=/home/pi/Patternflow/firmware/patternflow
#BUILD_WORK_DIR=/home/pi/patternflow-data/build-worker
#BUILD_ARTIFACT_DIR=/home/pi/patternflow-data/builds
#ARDUINO_CLI_PATH=arduino-cli
#BUILD_FQBN=esp32:esp32:esp32s3
